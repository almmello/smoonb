{
  "name": "smoonb",
  "version": "1.0.12",
  "description": "Complete Supabase backup and migration tool. https://www.smoonb.com/#price",
  "preferGlobal": false,
  "preventGlobalInstall": true,
  "main": "index.js",
  "bin": {
    "smoonb": "bin/smoonb.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node bin/smoonb.js",
    "preinstall": "node -e \"if(process.env.npm_config_global) { console.error('\\n\u274c SMOONB N\u00c3O DEVE SER INSTALADO GLOBALMENTE!\\n\\n\ud83d\udccb Para usar o smoonb, instale localmente no seu projeto:\\n   npm install smoonb\\n\\n\ud83d\udca1 Depois execute com:\\n   npx smoonb backup\\n\\n\ud83d\udeab Instala\u00e7\u00e3o global cancelada!\\n'); process.exit(1); }\"",
    "postinstall": "echo '\\n\u2705 smoonb instalado com sucesso!\\n\ud83d\udca1 Execute: npx smoonb backup\\n\ud83d\udcd6 Documenta\u00e7\u00e3o: https://github.com/almmello/smoonb\\n'",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "build": "node scripts/build.js",
    "build:check": "node scripts/build.js",
    "prepublishOnly": "npm test && npm run lint && npm run build",
    "test:docker": "node tests/integration/circular-restore.js",
    "test:restore:docker": "node tests/integration/verified-restore.js",
    "test:backup:docker": "node tests/integration/backup-isolation.js"
  },
  "keywords": [
    "supabase",
    "backup",
    "migration",
    "postgresql",
    "edge-functions",
    "database",
    "cli",
    "tool"
  ],
  "author": "Goalmoon Tecnologia LTDA <https://www.smoonb.com>",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.0",
    "adm-zip": "0.6.1",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "env-paths": "^4.0.0",
    "inquirer": "^8.2.7",
    "supabase": "2.122.1"
  },
  "type": "commonjs",
  "devDependencies": {
    "eslint": "^9.38.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almmello/smoonb.git"
  },
  "bugs": {
    "url": "https://github.com/almmello/smoonb/issues"
  },
  "homepage": "https://www.smoonb.com",
  "files": [
    "bin/",
    "src/",
    "README.md",
    "README.pt-BR.md",
    "LICENSE",
    "LICENSE.pt-BR.md",
    "CHANGELOG.md",
    "npm-shrinkwrap.json"
  ]
}
